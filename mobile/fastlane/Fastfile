# Fastlane pipeline for the Nosdesk Tauri mobile app.
#
# Division of labour: Tauri owns the build (frontend + Rust + native shell),
# Fastlane owns signing and store upload. iOS signing uses `match` (certs in a
# private git repo); Android signing uses a keystore written from a CI secret,
# consumed by the release signingConfig in app/build.gradle.kts.
#
# The app selects its server at runtime, so one build serves any environment.
# All paths are relative to `mobile/` (where fastlane runs).

# fastlane/README.md is hand-written; don't let fastlane regenerate it.
skip_docs

APP_ID          = ENV.fetch("APP_IDENTIFIER", "com.nosdesk.app")
APPLE_PROJECT   = "src-tauri/gen/apple/#{ENV.fetch('APPLE_PROJECT_NAME', 'Nosdesk')}.xcodeproj"
APPLE_INFO_PLIST = "src-tauri/gen/apple/app_iOS/Info.plist"
IPA_PATH        = "src-tauri/gen/apple/build/arm64/#{ENV.fetch('APPLE_PROJECT_NAME', 'Nosdesk')}.ipa"
AAB_PATH        = "src-tauri/gen/android/app/build/outputs/bundle/universalRelease/app-universal-release.aab"

# Monotonic build number so re-uploads of the same marketing version never
# collide on either store. CI passes github.run_number; local runs get 1.
def build_number
  ENV["BUILD_NUMBER"] || "1"
end

# Run the Tauri CLI through the workspace's pinned pnpm.
def tauri(*args)
  sh("pnpm", "tauri", *args)
end

# The marketing version, from the one place Tauri reads it. Lane code runs
# inside fastlane/, so the path is taken from fastlane's own folder.
def app_version
  JSON.parse(File.read(File.join(FastlaneCore::FastlaneFolder.path, "..", "src-tauri", "tauri.conf.json"))).fetch("version")
end

# Listing text and screenshots are generated in nosdesk-com
# (apps/marketing/video/store/out/fastlane) and read from there, so the images
# stay out of this repo. Layout: metadata/<locale>/ and screenshots/<locale>/
# for iOS, metadata/android/<locale>/ for Play.
def store_assets
  dir = File.expand_path(ENV.fetch("STORE_ASSETS_DIR"))
  UI.user_error!("STORE_ASSETS_DIR has no metadata folder: #{dir}") unless File.directory?(File.join(dir, "metadata"))
  dir
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"), # base64 of the .p8
    is_key_content_base64: true,
  )
end

# The App Store listing, shared by the metadata and release lanes.
def deliver_listing(**options)
  deliver(
    api_key: asc_api_key,
    app_version: app_version,
    metadata_path: File.join(store_assets, "metadata"),
    screenshots_path: File.join(store_assets, "screenshots"),
    ignore_language_directory_validation: true, # metadata/android is Play's
    overwrite_screenshots: true,
    skip_binary_upload: true,
    primary_category: "BUSINESS",
    secondary_category: "PRODUCTIVITY",
    precheck_include_in_app_purchases: false,
    force: true, # no HTML preview prompt
    # The reviewer's contact and demo account. Sent on every upload: deliver
    # reads the version's review detail unconditionally, and only this
    # creates it on a first submission.
    app_review_information: {
      first_name: ENV.fetch("REVIEW_FIRST_NAME"),
      last_name: ENV.fetch("REVIEW_LAST_NAME"),
      phone_number: ENV.fetch("REVIEW_PHONE"),
      email_address: ENV.fetch("REVIEW_EMAIL"),
      demo_user: ENV.fetch("REVIEW_DEMO_USER"),
      demo_password: ENV.fetch("REVIEW_DEMO_PASSWORD"),
      notes: ENV.fetch("REVIEW_NOTES", "On the first screen tap Nosdesk Cloud, then sign in with the demo account. It opens a workspace with sample tickets, requesters and devices."),
    },
    **options,
  )
end

platform :ios do
  desc "Build and upload an iOS build to TestFlight"
  lane :beta do
    setup_ci # ephemeral keychain on hosted runners; a no-op locally

    api_key = asc_api_key

    # Generate the Xcode project (gitignored; xcodegen builds it from
    # project.yml). Required before build on a fresh CI checkout.
    tauri("ios", "init", "--ci", "--skip-targets-install")

    # Stamp the build number and re-assert export compliance (init regenerates
    # the plist from templates).
    set_info_plist_value(path: APPLE_INFO_PLIST, key: "CFBundleVersion", value: build_number)
    set_info_plist_value(path: APPLE_INFO_PLIST, key: "ITSAppUsesNonExemptEncryption", value: false)

    # Tauri owns the code signing. It imports the distribution cert and profile
    # and signs the archive from the environment the workflow sets:
    # IOS_CERTIFICATE / IOS_CERTIFICATE_PASSWORD / IOS_MOBILE_PROVISION +
    # APPLE_DEVELOPMENT_TEAM. No fastlane cert/profile handling needed.
    tauri("ios", "build", "--export-method", "app-store-connect")

    upload_to_testflight(
      api_key: api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload the App Store listing (text, categories, screenshots) without submitting"
  lane :metadata do
    deliver_listing(submit_for_review: false)
  end

  desc "Submit TestFlight build BUILD_NUMBER for App Store review, with the listing"
  lane :release do
    deliver_listing(
      build_number: ENV.fetch("BUILD_NUMBER"),
      submit_for_review: true,
      automatic_release: true,
      submission_information: { export_compliance_uses_encryption: false, content_rights_contains_third_party_content: false },
    )
  end
end

platform :android do
  desc "Build and upload an Android build to the Play internal track"
  lane :beta do
    tauri("android", "build", "--aab")
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload the Play listing (text, icon, feature graphic, screenshots) without a release"
  lane :metadata do
    upload_to_play_store(
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      metadata_path: File.join(store_assets, "metadata", "android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      sync_image_upload: true,
    )
  end

  desc "Promote the Play internal track to production"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
