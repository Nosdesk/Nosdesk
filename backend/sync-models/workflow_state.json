    "category": { "rust": "WorkflowStateCategory", "ts": "WorkflowStateCategory" },
    "color": { "rust": "String", "ts": "string" },
    "position": { "rust": "i32", "ts": "number" },
    "is_default": { "rust": "bool", "ts": "boolean" },
    "archived_at": { "rust": "Option<DateTime<Utc>>", "ts": "string | null" }
