{
  "name": "asset_usage",
  "schema_version": 1,
  "fields": {
    "id": { "rust": "i32", "ts": "number", "primary": true },
    "asset_id": { "rust": "i32", "ts": "number" },
    "asset_name": { "rust": "String", "ts": "string" },
    "ticket_id": { "rust": "Option<i32>", "ts": "number | null" },
    "quantity_used": { "rust": "String", "ts": "string", "note": "decimal serialized as string" },
    "unit": { "rust": "String", "ts": "string" },
    "event_kind": { "rust": "String", "ts": "string" },
    "notes": { "rust": "Option<String>", "ts": "string | null" },
    "recorded_at": { "rust": "NaiveDateTime", "ts": "string" }
  },
  "events": [
    { "type": "asset_usage.recorded", "op": "I", "note": "append-only ledger event; not pool-materialised, consumed via useSyncActions by the usage-history panels" }
  ],
  "groups": [
    "workspace:1",
    "asset:<asset_id>",
    "ticket:<ticket_id> when the usage is tied to a ticket"
  ],
  "references": [
    { "field": "asset_id", "aggregate": "asset" },
    { "field": "ticket_id", "aggregate": "ticket" }
  ]
}
