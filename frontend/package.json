    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^26.2.0",
