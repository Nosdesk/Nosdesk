<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Dark-mode override of Theme.app; @color/launch_background resolves to
             the dark launch field (values-night/colors.xml). Keep in sync with
             values/themes.xml. -->
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
    </style>
</resources>
