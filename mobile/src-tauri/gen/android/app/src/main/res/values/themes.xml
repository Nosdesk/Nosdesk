<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand cold-start field. windowBackground paints the native starting
             window (all API levels) before the WebView attaches; the Android 12+
             system splash uses windowSplashScreenBackground. Both reference the
             day/night @color/launch_background, so there's no white flash and it
             matches the iOS LaunchScreen + web splash. See tauri #12743. -->
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
    </style>
</resources>
