# syntax=docker/dockerfile:1.7
# Development Dockerfile for faster iteration
FROM rust:1.95-slim-bookworm AS development

# Install development dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    postgresql-client \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# pdfium for PDF thumbnails. https://github.com/bblanchon/pdfium-binaries
# Pinned + sha256-verified; keep in sync with backend/Dockerfile. See
# security-audit-2026-06.
ARG TARGETARCH
ARG PDFIUM_VERSION=chromium/7881
RUN case "$TARGETARCH" in \
      arm64) PDFIUM_PKG=pdfium-linux-arm64.tgz; PDFIUM_SHA256=ee7f7b7d5468958336a818c1cd580bdd20972846b7377b13f9a923d92d1d4674 ;; \
      amd64) PDFIUM_PKG=pdfium-linux-x64.tgz;   PDFIUM_SHA256=1470e21b8b4a3b4ad7f85684e2da11d94f3b69a86d81dee11b9b6709d927ac1d ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2 && exit 1 ;; \
    esac && \
    mkdir -p /tmp/pdfium && \
    cd /tmp/pdfium && \
    wget -q "https://github.com/bblanchon/pdfium-binaries/releases/download/${PDFIUM_VERSION}/$PDFIUM_PKG" && \
    echo "${PDFIUM_SHA256}  ${PDFIUM_PKG}" | sha256sum -c - && \
    tar -xzf "$PDFIUM_PKG" && \
    cp lib/libpdfium.so /usr/local/lib/ && \
    ldconfig && \
    rm -rf /tmp/pdfium

# Install useful development tools with BuildKit cache mounts.
# `rustfmt` and `clippy` need explicit rustup component adds because
# the slim rust image ships without them; without these, `cargo fmt`
# inside the container silently no-ops and we ship formatting drift
# that only fails in CI.
RUN rustup component add rustfmt clippy
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install diesel_cli --no-default-features --features postgres --locked && \
    cargo install bacon --locked

# Dev shim for `nosdesk-cli`. The production image ships a compiled
# binary (backend/Dockerfile); the dev image builds the app at runtime
# via bacon against watch-synced source, so a baked binary would go
# stale immediately. This wrapper compiles-and-runs the CLI from the
# current source on demand (cached in the target volume after first
# use), so `docker compose exec nosdesk nosdesk-cli ...` works and
# always matches the running code.
RUN printf '#!/bin/sh\ncd /app\nexec cargo run --quiet --bin nosdesk-cli -- "$@"\n' \
      > /usr/local/bin/nosdesk-cli \
    && chmod +x /usr/local/bin/nosdesk-cli

WORKDIR /app

# Bake the source into the image so the container is bootable on
# cold start. Subsequent host edits land in the container via
# `docker compose watch` (compose.dev.yaml's `develop.watch`),
# which copies changed files over the baked-in copy. The image's
# source goes stale fast, but that's fine — watch keeps the
# running container in sync with the host every dev session.
COPY backend/Cargo.toml backend/Cargo.lock ./
# build.rs computes the NOSDESK_SCHEMA_HASH env var that `db.rs`
# stamps into bootstrap responses; without it the lib fails to
# compile (`env!("NOSDESK_SCHEMA_HASH") not defined at compile
# time`). Bake it into the image so cold starts work.
COPY backend/build.rs ./build.rs
COPY backend/src ./src
# license.rs uses include_str!("../license_pubkey.pem") — must exist at
# compile time. Not in the develop.watch sync set, so it has to be baked
# into the image (mirrors the prod backend/Dockerfile COPY).
COPY backend/license_pubkey.pem ./license_pubkey.pem
COPY backend/migrations ./migrations
COPY backend/tests ./tests
# sync-models manifests are read by `tests/sync_model_registry.rs`
# (validates manifest ↔ Rust enum drift). Bake them in so
# `cargo test` works without a separate sync step.
COPY backend/sync-models ./sync-models
# starter_catalog.rs uses include_str!("../../data/starter-rules.json")
# — must exist at compile time.
COPY backend/data ./data
COPY backend/diesel.toml ./diesel.toml
# Shared Fluent message catalogues. The backend `include_str!`s
# these from src/utils/i18n.rs at compile time. Path lives at
# workspace root (one level above `backend/`) so the frontend can
# import the same files; in the container we mirror that layout
# at `/i18n` so the `../../../i18n/locales/...` include path
# resolves correctly.
COPY i18n /i18n

# Note: We don't pre-build here because target/ is mounted as a volume.
# The first run will compile everything, subsequent runs use cached artifacts.

# Set up for live reloading with bacon (modern cargo-watch replacement)
# Bacon provides better TUI and is actively maintained
ENV RUST_BACKTRACE=1
ENV RUST_LOG_STYLE=always
# Use bacon in headless mode for Docker (no TUI, just logs)
CMD ["bacon", "--headless", "run"] 