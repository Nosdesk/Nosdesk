# Docker Compose Environment Configuration
# Copy this file to .env and fill in your values

# ===== Plugin Registry =====
# Build-time: Ed25519 root pubkey the binary uses to verify the
# Nosdesk plugin registry (publishers.json + index.json) and
# official-tier plugin signatures. Compile-time variable — changing
# this requires `docker compose build`, not just a restart. Leave
# empty to build without a trust root; the instance will still
# accept CLI-signed local plugins and filesystem-provisioned ones.
# Official Nosdesk builds use the root pubkey published at
# https://nosdesk.com/registry/root.pub
NOSDESK_ROOT_PUBKEY=

# Runtime: base URL of the plugin registry. Defaults to
# https://nosdesk.com/registry when unset. Set to empty string to
# disable registry sync entirely (air-gapped deployments).
NOSDESK_REGISTRY_URL=

# Web sideload escape hatch. Off by default: admins cannot upload a
# signed plugin zip through the browser. Operators with shell
# access can always install via the CLI (`nosdesk-cli plugin
# install`); the env flag below also re-enables the web upload UI
# for staging or development. A signature only proves the bundle
# is intact, not that the publisher's intent is benign, so the
# threat model treats web sideload as additional capability for an
# already-compromised admin account.
# Set to 1, true, or yes to enable.
NOSDESK_ALLOW_WEB_SIDELOAD=

# Allowed plugin trust tiers. Comma-separated list from
# {official, verified, community, local}. When unset, release
# builds default to "official,local" — verified and community
# plugins both run third-party code in-process with full DOM
# access, so they're locked off until the Phase 4 sandbox ships.
# Operators who accept the current risk can opt back in
# explicitly:
#   NOSDESK_ALLOWED_PLUGIN_TIERS=official,verified,community,local
# Debug builds default to all four tiers (developer convenience).
NOSDESK_ALLOWED_PLUGIN_TIERS=

# Sibling origin that serves the cross-origin iframe sandbox for
# community-tier plugins. When set, the CSP frame-src directive
# permits this origin and the frontend will route community
# plugins through the sandbox runtime. When empty, community
# plugins fall back to the in-process API path (same as today).
# Set to a separate registrable subdomain like
# https://plugins.nosdesk.example so the sandbox iframe is treated
# as an opaque origin and cannot reach session cookies.
PLUGIN_SANDBOX_ORIGIN=

# Security Configuration
# Generate a secure JWT secret with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Keyring KEKs for at-rest encryption (MFA TOTP secrets, channel
# credentials, plugin signing key, plugin secret settings). One env
# var per loaded generation; MFA_KEK_VERSION picks the current-write
# key. Single-key installs can omit MFA_KEK_VERSION.
#
# Generate each key with: openssl rand -hex 32
#
# Rotation procedure (zero-downtime): provision MFA_KEK_V2 →
# bump MFA_KEK_VERSION=2 → re-wrap rows on next write or via the
# planned `nosdesk-cli rewrap-secrets` job → unset MFA_KEK_V1.
MFA_KEK_V1=your-64-character-hex-encryption-key-change-this-in-production
# MFA_KEK_VERSION=1

# Tenant-domain suffix for hosted mode. Unset for self-hosted
# (rely on FRONTEND_URL alone). When set (e.g. `nosdesk.app`):
#   - CORS: every `<slug>.<tenant_domain>` origin passes the preflight
#     without per-tenant config. Anchored at the end of the host so
#     substring-bypass attempts (`https://acme.nosdesk.app.attacker.com`)
#     can't slip through.
#   - Managed email identity (hosted only): a workspace with no verified
#     sending domain or SMTP relay sends as, and receives at,
#     `support@<slug>.<tenant_domain>` through the platform relay.
#     Requires the SES-side setup in docs/plans/inbound-email-infra-runbook.md
#     (domain identity for the tenant domain + wildcard-MX receiving);
#     without it, hosted workspace mail defers as before.
# NOSDESK_TENANT_DOMAIN=nosdesk.app

# Environment — production | development | dev | staging | ...
# Auth cookies use Secure unless this is development/dev (fail-closed default),
# and the placeholder-secret / key-strength startup gates only enforce in
# production. This file is the template a real deployment copies, so it
# defaults to production: leaving the example JWT_SECRET/MFA_KEK_V1 in place
# then fails fast instead of booting with a forgeable key. The dev stack
# (compose.dev.yaml) overrides this back to development. See security-audit-2026-06.
ENVIRONMENT=production

# Labs ONLY (production): allow .env.example Postgres/Redis passwords to boot.
# Never enable outside isolated test environments.
# ALLOW_INSECURE_DEFAULT_SECRETS=

# MFA Policy
# Require admins to set up MFA (recommended). Set to false to disable during local/dev.
# Accepted values: true/false, 1/0, yes/no, on/off (case-insensitive)
REQUIRE_ADMIN_MFA=true

# WebAuthn / Passkeys
# RP ID and origin MUST match the host you browse from, or the browser
# rejects passkey registration. Default docker dev is localhost:8080; if
# you front the stack with a proxy (e.g. OrbStack's *.orb.local), set both
# to that host instead. Required in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
# WEBAUTHN_RP_NAME=Nosdesk

# Server Configuration
PORT=8080
# Host binding - use 127.0.0.1 for local only, 0.0.0.0 for all interfaces
HOST=0.0.0.0

# Rate Limiting Configuration
# Max requests per IP per minute for unauthenticated users
RATE_LIMIT_PER_MINUTE=60
# Rate limiting for authenticated users (higher limit)
AUTH_RATE_LIMIT_PER_MINUTE=600

# File Upload Configuration
# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# CORS Configuration
# Canonical origin (scheme://host[:port], no trailing path). Drives CORS,
# the realtime-collaboration WebSocket origin check, and the base URL for
# links in outbound email + the onboarding URL, so set it to the address
# users actually load.
FRONTEND_URL=http://localhost:3000
# Extra origins allowed to reach the app, comma-separated. Applies to both
# the API and realtime collaboration. Use this to permit a second access
# path alongside FRONTEND_URL, e.g. an internal IP when there's no domain:
#   FRONTEND_URL=https://helpdesk.example.org
#   ADDITIONAL_CORS_ORIGINS=https://10.0.5.20:8443
ADDITIONAL_CORS_ORIGINS=

# Native (Tauri) app support. The desktop/mobile app's webview presents a fixed
# platform origin (tauri://localhost, http(s)://tauri.localhost); these are
# trusted by default so the app's realtime features (SSE + collaboration WS,
# which run in the webview) work. REST is unaffected (it uses the native HTTP
# client). Set to false to refuse the native app on this server. A web page
# can't forge these origins, and SSE/WS stay token-authenticated regardless.
# NOSDESK_ALLOW_NATIVE_APP=false

# Logging Configuration
# Set overall log level (error, warn, info, debug, trace)
# Use 'info' for development (less verbose), 'debug' for detailed debugging
RUST_LOG=info

# Microsoft Entra ID Configuration (Optional)
# Leave empty if not using Microsoft authentication
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# ===== OpenID Connect (OIDC) Configuration =====
# Generic OIDC provider support for any compatible identity provider
# (Keycloak, Auth0, Okta, Google, GitLab, Authentik, Authelia, etc.)

# Required: OIDC Client credentials
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Native (mobile app) OIDC client: the PUBLIC client id the app uses for its own
# Authorization-Code + PKCE flow against the IdP (no secret). Register it on the
# IdP with redirect_uri nosdesk://auth/callback. Defaults to "nosdesk-app".
# OIDC_NATIVE_CLIENT_ID=nosdesk-app

# Option 1: Auto-discovery (Recommended)
# Just provide the issuer URL and endpoints are discovered automatically
OIDC_ISSUER_URL=

# Option 2: Manual configuration (if provider doesn't support discovery)
# Only needed if OIDC_ISSUER_URL is not set
# OIDC_AUTH_URI=https://your-provider.com/authorize
# OIDC_TOKEN_URI=https://your-provider.com/token
# OIDC_USERINFO_URI=https://your-provider.com/userinfo

# Redirect URI for OIDC callback (must match provider configuration)
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback

# Optional: Customize the display name shown on login button (default: "OpenID")
OIDC_DISPLAY_NAME=SSO

# Optional: Scopes to request (default: "openid profile email")
# OIDC_SCOPES=openid profile email

# Optional: Claim to use for username (default: "preferred_username")
# Options: preferred_username, email, name, sub
# OIDC_USERNAME_CLAIM=preferred_username

# Optional: Logout URL for single logout
# OIDC_LOGOUT_URI=https://your-provider.com/logout

# Optional: Set to true to prevent auto-redirect to OIDC provider
# OIDC_DISABLE_REDIRECT=false

# PostgreSQL Configuration (Optional - uses defaults if not set)
POSTGRES_DB=nosdesk
POSTGRES_USER=nosdesk
POSTGRES_PASSWORD=nosdesk_password

# Database Configuration
DATABASE_URL=postgres://nosdesk:nosdesk_password@postgres:5432/nosdesk
# Connection pool, per backend machine. Budget against the Postgres
# `max_connections`: peak per machine = DB_MAX_CONNECTIONS + the dedicated
# LISTEN connections (2, or 3 with NOSDESK_SEARCH_REPLICATION). Across N
# machines reserve N x (that peak) + headroom (migrations, psql, monitoring).
DB_MAX_CONNECTIONS=10           # pool cap (clamped 2..100)
# Idle connections held while quiet; grows to the cap under load. Low keeps
# idle machines light on a shared cluster.
DB_MIN_CONNECTIONS=1            # never exceeds DB_MAX_CONNECTIONS
# Seconds a request waits for a free connection before erroring (pool full).
DB_CONNECTION_TIMEOUT=30        # clamped 1..120
# SSL mode is not a separate variable — append it to DATABASE_URL's query
# string when needed, e.g. DATABASE_URL=postgres://...@host:5432/db?sslmode=require

# Redis Configuration (Optional - uses defaults if not set)
REDIS_PASSWORD=nosdesk_redis_password
# Redis connection string. Required in production (rate limiting, the collab
# cache, and the readiness probe depend on it; the backend refuses to boot
# without it). Only development/dev falls back to redis://localhost:6379.
REDIS_URL=redis://:nosdesk_redis_password@redis:6379

# Microsoft Graph Sync Configuration (Optional)
# Concurrent processing and batch sizing
MSGRAPH_CONCURRENT_USER_PROCESSING=5
MSGRAPH_USER_BATCH_SIZE=10

# Skip disabled user accounts during sync (default: true)
# Set to false if you want to sync disabled accounts as well
MSGRAPH_SKIP_DISABLED_ACCOUNTS=true

# Email Configuration (SMTP)
# Enable/disable email functionality
SMTP_ENABLED=false
# SMTP server hostname
SMTP_HOST=smtp.gmail.com
# SMTP server port (587 for STARTTLS, 465 for implicit TLS)
SMTP_PORT=587
# Transport security: starttls (default, port 587) | tls (implicit, port
# 465) | plaintext (local test servers like Mailpit only; never in prod)
SMTP_SECURITY=starttls
# SMTP authentication username
SMTP_USERNAME=your-email@example.com
# SMTP authentication password or app-specific password
SMTP_PASSWORD=your-smtp-password
# Display name for sent emails
SMTP_FROM_NAME=Nosdesk
# From email address (defaults to SMTP_USERNAME if not set)
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Session Geolocation (Optional)
# Path (inside the container) to a MaxMind-format .mmdb database used to
# show a coarse "City, Country" per active session. Fully offline: no IP
# leaves the server. Leave unset to disable. Mount any .mmdb you have the
# right to use: DB-IP Lite (free, CC BY 4.0, credit DB-IP), DB-IP/MaxMind
# commercial (paid, no attribution), or MaxMind GeoLite2 (free w/ account).
# GEOIP_DB_PATH=/app/data/geoip/dbip-country-lite.mmdb

# Deployment Mode (Optional, default: self-hosted)
# Set to "hosted" ONLY for the managed multi-tenant deployment run by
# the Nosdesk control plane. Self-hosted operators should leave this
# unset. In any non-hosted mode the control-plane provisioning surface
# (/api/internal/v1/*) returns 404 and the two vars below are ignored.
# NOSDESK_DEPLOYMENT_MODE=hosted

# Platform Provisioning Auth (hosted mode only)
# The control plane signs short-lived EdDSA (Ed25519) JWTs and presents
# them as Bearer tokens to /api/internal/v1/*. This instance verifies
# them against the operator-provided public key and issuer. Both must be
# set in hosted mode or every platform request fails closed (401).
#   PLATFORM_PUBLIC_KEY - the control plane's Ed25519 public key in SPKI
#                         PEM form (the "-----BEGIN PUBLIC KEY-----" block).
#   PLATFORM_ISSUER     - the exact `iss` claim the control plane mints.
# PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowB...replace-me...=\n-----END PUBLIC KEY-----\n"
# PLATFORM_ISSUER=https://control.nosdesk.example
