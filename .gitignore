.playwright-mcp/
nosdesk_backup_*.sql
nosdesk_pre_*.sql
docs/
# Throwaway fly dev/test app config (collab multi-instance validation).
# Stays local; a production fly.toml, if added later, is not matched here.
fly.dev.toml
# v1 release-candidate fly app config (personal-org, throwaway). Local-only
# like fly.dev.toml: keeps personal deploy config out of the public repo.
fly.rc.toml
# Hosted staging app config (personal-org nosdesk-dev). Deploy orchestration,
# not product code; stays local like the other fly.*.toml above.
fly.hosted-test.toml

# Signed plugin zips dropped for provisioning. The directory is
# tracked (README explains the convention) but the artefacts are
# either built in CI or downloaded from the registry.
/plugins/*.zip

# Enterprise license signing key (private). Public counterpart is committed + embedded.
backend/license_private.pem

# Firebase client config (per-machine; contains the FCM API key)
google-services.json
